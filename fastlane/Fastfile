require 'fileutils'
require 'json'
require 'shellwords'

default_platform(:android)

platform :android do
  desc 'Build and upload the requested commit to Google Play Internal Testing'
  lane :preview do |options|
    commit = options[:commit] || ENV['PREVIEW_COMMIT']
    UI.user_error!('Pass a commit with commit:SHA or PREVIEW_COMMIT=SHA.') if commit.to_s.empty?

    package_name = ENV['ANDROID_PACKAGE_NAME']
    UI.user_error!('ANDROID_PACKAGE_NAME is required for a store preview (for example, com.oreliaukmz.meditationapp).') if package_name.to_s.empty?

    signing = signing_properties
    play_credentials = ENV['GOOGLE_PLAY_JSON_KEY_DATA'] || ENV['GOOGLE_PLAY_JSON_KEY_PATH']
    UI.user_error!('Set GOOGLE_PLAY_JSON_KEY_DATA or GOOGLE_PLAY_JSON_KEY_PATH before uploading.') if play_credentials.to_s.empty?

    checkout_commit(commit)
    version_code = next_version_code

    UI.message("Building Android preview for #{resolved_commit} (versionCode #{version_code})")
    ENV['ANDROID_PACKAGE_NAME'] = package_name
    ENV['ANDROID_VERSION_CODE'] = version_code.to_s
    sh('pnpm exec expo prebuild --platform android --clean --no-install')

    gradle(
      task: 'bundleRelease',
      project_dir: 'android',
      properties: {
        'versionCode' => version_code,
        'android.injected.signing.store.file' => signing[:store_file],
        'android.injected.signing.store.password' => signing[:store_password],
        'android.injected.signing.key.alias' => signing[:key_alias],
        'android.injected.signing.key.password' => signing[:key_password],
      },
      print_command: false
    )

    aab = File.expand_path('../android/app/build/outputs/bundle/release/app-release.aab', __dir__)
    UI.user_error!("Gradle did not produce #{aab}.") unless File.file?(aab)

    upload_to_play_store(
      aab: aab,
      package_name: package_name,
      track: ENV.fetch('GOOGLE_PLAY_TRACK', 'internal'),
      json_key_data: ENV['GOOGLE_PLAY_JSON_KEY_DATA'],
      json_key: ENV['GOOGLE_PLAY_JSON_KEY_PATH'],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    remember_version(version_code)
    UI.success("Uploaded #{package_name} versionCode #{version_code} for #{resolved_commit} to Google Play #{ENV.fetch('GOOGLE_PLAY_TRACK', 'internal')}.")
  end
end

platform :ios do
  desc 'Build the requested Expo commit and upload it to TestFlight'
  lane :preview do |options|
    bundle_identifier = ENV['IOS_BUNDLE_IDENTIFIER']
    UI.user_error!('IOS_BUNDLE_IDENTIFIER is required for a store preview.') if bundle_identifier.to_s.empty?
    team_id = ENV['IOS_TEAM_ID']
    UI.user_error!('IOS_TEAM_ID is required for code signing.') if team_id.to_s.empty?

    build_number = next_ios_build_number(options[:build_number] || ENV['IOS_BUILD_NUMBER'] || ENV['GITHUB_RUN_NUMBER'])
    UI.user_error!('IOS_BUILD_NUMBER must be a positive integer.') unless build_number.to_i.positive?

    ensure_git_status_clean
    sh('git fetch origin main --prune')
    target_sha = options[:sha] || ENV['PREVIEW_SHA'] || sh('git rev-parse origin/main').strip
    escaped_sha = Shellwords.escape(target_sha.to_s)
    sh("git rev-parse --verify #{escaped_sha}^{commit} >/dev/null")
    sh("git checkout --detach #{escaped_sha}")

    ENV['IOS_BUNDLE_IDENTIFIER'] = bundle_identifier
    sh('pnpm exec expo prebuild --platform ios --no-install')
    sh('bundle exec pod install --project-directory=ios')

    update_code_signing_settings(
      use_automatic_signing: true,
      path: 'ios/meditation-app.xcodeproj/project.pbxproj',
      team_id: team_id,
      bundle_identifier: bundle_identifier
    )
    increment_build_number(build_number: build_number.to_i, xcodeproj: 'ios/meditation-app.xcodeproj')

    gym(
      workspace: 'ios/meditation-app.xcworkspace',
      scheme: 'meditation-app',
      clean: true,
      export_method: 'app-store',
      export_options: { signingStyle: 'automatic', teamID: team_id },
      output_directory: 'fastlane/build',
      output_name: "meditation-app-#{build_number}.ipa"
    )

    pilot_options = { distribute_external: false, skip_waiting_for_build_processing: true }
    pilot_options[:api_key_path] = ENV['APP_STORE_CONNECT_API_KEY_PATH'] if ENV['APP_STORE_CONNECT_API_KEY_PATH']
    pilot(**pilot_options)
    remember_ios_build(build_number)
  end
end

private

def checkout_commit(commit)
  escaped_commit = Shellwords.escape(commit.to_s)
  sh("git rev-parse --verify #{escaped_commit}^{commit} >/dev/null")
  sh("git checkout --detach #{escaped_commit}")
end

def resolved_commit
  sh('git rev-parse --short HEAD').strip
end

def signing_properties
  required = {
    store_file: 'ANDROID_KEYSTORE_PATH',
    store_password: 'ANDROID_KEYSTORE_PASSWORD',
    key_alias: 'ANDROID_KEY_ALIAS',
    key_password: 'ANDROID_KEY_PASSWORD',
  }
  values = required.to_h do |key, env_name|
    value = ENV[env_name]
    UI.user_error!("#{env_name} is required to sign the release AAB.") if value.to_s.empty?
    [key, value]
  end
  UI.user_error!("Keystore not found: #{values[:store_file]}") unless File.file?(values[:store_file])
  values
end

def state_file
  ENV.fetch('ANDROID_PREVIEW_STATE_FILE', File.expand_path('~/.meditation-app/android-preview-state.json'))
end

def next_version_code
  prior = if File.file?(state_file)
            JSON.parse(File.read(state_file)).fetch('last_version_code', 0).to_i
          else
            0
          end
  requested = ENV.fetch('ANDROID_VERSION_CODE', ENV.fetch('GITHUB_RUN_NUMBER', '0')).to_i
  [prior + 1, requested].max
end

def remember_version(version_code)
  FileUtils.mkdir_p(File.dirname(state_file))
  File.write(state_file, JSON.pretty_generate({ 'last_version_code' => version_code, 'commit' => resolved_commit }) + "\n")
end

def ios_state_file
  ENV.fetch('IOS_PREVIEW_STATE_FILE', File.expand_path('~/.meditation-app/ios-preview-state.json'))
end

def next_ios_build_number(requested)
  prior = if File.file?(ios_state_file)
            JSON.parse(File.read(ios_state_file)).fetch('last_build_number', 0).to_i
          else
            0
          end
  requested_number = requested.to_i
  [prior + 1, requested_number].max
end

def remember_ios_build(build_number)
  FileUtils.mkdir_p(File.dirname(ios_state_file))
  File.write(ios_state_file, JSON.pretty_generate({ 'last_build_number' => build_number, 'commit' => resolved_commit }) + "\n")
end
