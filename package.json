    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.3.0",
    "@webgpu/types": "^0.1.72",
    "babel-preset-expo": "~58.0.4",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~58.0.3",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "unplugin-typegpu": "^0.12.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check . --write --unsafe",
    "lint:ci": "biome ci .",
    "test": "jest --cache",
    "test:ci": "jest --ci --coverage",
    "test:watch": "jest --watch",
    "test:e2e:web": "maestro test --platform web .maestro/web-principal-flow.yaml",
    "test:e2e:android": "maestro test .maestro/android-principal-flow.yaml",
    "test:e2e:ios": "maestro test .maestro/ios-principal-flow.yaml",
    "typecheck": "tsc --noEmit",
    "security:scan": "trivy fs --exit-code 1 --ignore-unfixed --severity HIGH,CRITICAL .",
    "secrets:scan": "gitleaks detect --source . --no-banner --redact",
    "expo:prebuild": "expo prebuild --clean --no-install",
    "expo:export:web": "expo export --platform web",
    "expo:export:github-pages": "EXPO_BASE_URL=/meditation-app expo export --platform web && cp dist/index.html dist/404.html",
    "expo:doctor": "pnpm dlx expo-doctor@latest",
    "react-compiler:healthcheck": "pnpm dlx react-compiler-healthcheck@latest",
    "claude:sbx": "sbx run ./sandbox/kits/claude-sonnet -t claude-code-pnpm:v1 --clone --static-mcp expo",
    "codex:sbx": "sbx run ./sandbox/kits/codex-luna -t codex-pnpm:v1 --clone --static-mcp expo",
    "prepare": "husky",
    "investigate:files": "knip"
  },
  "private": true,
  "packageManager": "pnpm@12.4.1+sha256.6276298e9af576b7a7f5e9044bfafbe2678209250cd10b1705ea5d3aa64d4882"
}
