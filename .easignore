# When present, .easignore REPLACES .gitignore for EAS Build uploads,
# so everything from .gitignore is repeated here.

# dependencies (installed on the EAS worker)
node_modules/
.pnpm-store/
coverage/
.next/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# generated native folders (regenerated by prebuild on EAS)
/ios
/android
apps/mobile/ios/
apps/mobile/android/
apps/mobile/dist/

# Native / signing secrets (use EAS credentials instead)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro / debug
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files (use EAS env vars / secrets instead)
.env
.env*.local

# macOS / TypeScript
.DS_Store
*.tsbuildinfo

# local build outputs
/build
*.aab
*.apk
*.ipa
*.tar

# tooling not needed to build the app
.git/
.codex/
.opencode/
.claude/
.agents/
.vscode/
.maestro/
.github/
sandbox/
marketing/
docs/
Docker-sbx.md
skills-lock.json
example
